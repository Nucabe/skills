#!/usr/bin/env bash
#MISE description="Scan the git history for secrets with trufflehog"
#USAGE flag "--base <sha>" env="SECRET_SCAN_BASE" help="Scan only the commits after this commit"
#USAGE flag "--head <sha>" env="SECRET_SCAN_HEAD" help="Scan only the commits up to this commit"
#
# Each flag can also come from its environment variable. A flag on the
# command line wins. With no flag and no variable, or with an empty
# variable, the task scans the full history of every branch.
#
# --no-verification keeps every finding on this machine. Without it,
# trufflehog sends each candidate secret to its provider to test it.
#
# The output never contains the secret value. In GitHub Actions, each
# finding is an error annotation, and the step summary lists all of them,
# because GitHub shows at most 10 error annotations per step.

set -euo pipefail
IFS=$'\n\t'

readonly ADVICE="Remove each one from every commit on the branch, then rotate it."

# Global, so that the EXIT trap can still read it after main returns.
results=""

cleanup() {
  if [ -n "$results" ]; then
    rm -f "$results"
  fi
}

# Write the trufflehog findings to $results, one JSON object per line.
scan() {
  local args=(--no-verification --no-update --json)
  if [ -n "${usage_base:-}" ]; then
    args+=(--since-commit "$usage_base")
  fi
  if [ -n "${usage_head:-}" ]; then
    args+=(--branch "$usage_head")
  fi

  trufflehog git "file://$(git rev-parse --show-toplevel)" "${args[@]}" > "$results"
}

# Markdown table of all findings, for the terminal and the step summary.
table() {
  echo "| Commit | File | Line | Detector |"
  echo "|---|---|---|---|"
  jq -r '
    def cell: tostring | gsub("[\r\n]"; " ") | gsub("\\|"; "\\|") | gsub("`"; "");
    .SourceMetadata.Data.Git as $g
    | "| `\($g.commit[0:12])` | `\($g.file | cell)` | \($g.line) | \(.DetectorName | cell) |"
  ' "$results"
}

# One error annotation per finding. File names come from the pull
# request, so escape every character that can end a workflow command
# property or message.
annotate() {
  jq -r '
    def msg: tostring | gsub("%"; "%25") | gsub("\r"; "%0D") | gsub("\n"; "%0A");
    def prop: msg | gsub(":"; "%3A") | gsub(","; "%2C");
    .SourceMetadata.Data.Git as $g
    | "::error file=\($g.file | prop),line=\($g.line | prop),title=\("Secret: \(.DetectorName)" | prop)::"
      + ("Commit \($g.commit[0:12]) adds a possible secret on this line (\(.DetectorName)). Remove it from every commit on the branch, then rotate it." | msg)
  ' "$results"
}

report_clean() {
  echo "No secrets found."
  if [ -n "${GITHUB_STEP_SUMMARY:-}" ]; then
    echo "No secrets found." >> "$GITHUB_STEP_SUMMARY"
  fi
}

report_findings() {
  local count=$1

  if [ "${GITHUB_ACTIONS:-}" = true ]; then
    annotate
    {
      echo "## Secret scan"
      echo
      echo "Possible secrets found: $count. $ADVICE"
      echo
      table
    } >> "$GITHUB_STEP_SUMMARY"
  else
    echo "Possible secrets found: $count. $ADVICE"
    echo
    table
  fi
}

main() {
  results=$(mktemp)
  trap cleanup EXIT

  scan

  local count
  count=$(jq -s length "$results")
  if [ "$count" -eq 0 ]; then
    report_clean
    return 0
  fi

  report_findings "$count"
  return 1
}

main "$@"

#!/usr/bin/env bash
#MISE description="Check the mise tasks with shellcheck"
#
# The tasks have no file extension, so the task finds every file under
# .mise/tasks and checks each one as bash.
#
# In GitHub Actions, each finding is an annotation on its file and line.

set -euo pipefail
IFS=$'\n\t'

readonly TASKS_DIR=.mise/tasks

# Print each task file, one per line, relative to the repository root.
task_files() {
  find "$TASKS_DIR" -type f | sort
}

# One annotation per finding. Paths and messages are escaped, so that
# they cannot end a workflow command property or message.
annotate() {
  jq -r '
    def msg: tostring | gsub("%"; "%25") | gsub("\r"; "%0D") | gsub("\n"; "%0A");
    def prop: msg | gsub(":"; "%3A") | gsub(","; "%2C");
    def kind: {"error": "error", "warning": "warning"}[.] // "notice";
    .comments[]
    | "::\(.level | kind) file=\(.file | prop),line=\(.line),endLine=\(.endLine),col=\(.column),endColumn=\(.endColumn),title=\("SC\(.code)" | prop)::"
      + (.message | msg)
  '
}

main() {
  cd "$(git rev-parse --show-toplevel)"

  local files=() file
  while read -r file; do
    files+=("$file")
  done < <(task_files)

  local args=(--shell=bash --external-sources)

  if [ "${GITHUB_ACTIONS:-}" != true ]; then
    shellcheck "${args[@]}" "${files[@]}"
    return
  fi

  local status=0 report
  report=$(shellcheck --format=json1 "${args[@]}" "${files[@]}") || status=$?
  annotate <<< "$report"
  return "$status"
}

main "$@"
